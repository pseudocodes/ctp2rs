# trader 示例环境变量样例
# 复制为 .env 并填入实际账号信息（.env 请勿提交到版本库）

# ── 必填 ──
# SimNow 投资者账号（https://www.simnow.com.cn 注册）
SIMNOW_USER_ID=123456
# SimNow 密码
SIMNOW_PASS=your_password

# ── 可选（不设置时使用默认值）──
# 经纪商代码，SimNow 固定为 9999
# CTP_BROKER_ID=9999
# 客户端认证 AppID
# CTP_APP_ID=simnow_client_test
# 客户端认证授权码
# CTP_AUTH_CODE=0000000000000000
# 交易前置地址，默认 SimNow 7x24 环境
# CTP_TD_FRONT=tcp://182.254.243.31:40001

# 日志级别（trace/debug/info/warn/error），默认 info
# RUST_LOG=info
